# =============================================================================
# Sistema de Gestion de Inventarios - INICTEL-UNI
# PLANTILLA de variables de entorno  (RNF-45: ningun secreto en el codigo)
#
# Este es el UNICO archivo de entorno que se versiona en git. No contiene
# secretos reales: es el contrato de que necesita el backend para arrancar.
#
#   Desarrollo:  copie este archivo a .env       y ajuste los valores
#   Produccion:  copie este archivo a .env.prod  y reemplace cada __SECRETO__
#
# REGLA DE NOMBRES: el nombre de la variable es la ruta de la propiedad de
# Spring en MAYUSCULAS con guiones bajos.
#   spring.datasource.url  ->  SPRING_DATASOURCE_URL
#   app.jwt.secret         ->  APP_JWT_SECRET
# No hay nombres inventados: los mismos que Spring Boot y Docker entienden
# de forma nativa, sin traduccion intermedia.
#
# FORMATO: se lee como un .properties de Java.
#   - Sin comillas alrededor de los valores (se guardarian como parte del texto)
#   - Sin espacios alrededor del '='
#   - Rutas de Windows con barra normal:  C:/datos/uploads   NO  C:\datos\uploads
#     (la barra invertida es un caracter de escape y se pierde)
#   - '#' al inicio de linea es comentario
# =============================================================================


# ===== 1. PERFIL ACTIVO ======================================================
# Lo decide quien arranca la aplicacion, no este archivo:
#   dev  -> lee .env       (por defecto)
#   prod -> lee .env.prod  (exportando SPRING_PROFILES_ACTIVE=prod)


# ===== 2. SERVIDOR HTTP ======================================================
SERVER_PORT=8080
# Hilos de Tomcat. Con hilos virtuales activos no es el cuello de botella.
SERVER_TOMCAT_THREADS_MAX=400


# ===== 3. BASE DE DATOS (PostgreSQL 16+) =====================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/inventario
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=__SECRETO__

# Pool de conexiones (RNF-15). 300 usuarios concurrentes no necesitan 300
# conexiones: las peticiones son cortas y casi todas lecturas paginadas.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=50
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=10


# ===== 4. JPA / HIBERNATE ====================================================
# El esquema lo administra Flyway (RNF-43); Hibernate solo valida.
# Aqui solo se elige si las consultas se imprimen en el log.
SPRING_JPA_SHOW_SQL=false

# RNF-11: hilos virtuales de Java 21.
SPRING_THREADS_VIRTUAL_ENABLED=true


# ===== 5. JWT (RF-02, RNF-02) ================================================
# Clave HMAC-SHA512. Minimo 64 caracteres.
# Generar:  openssl rand -base64 64
APP_JWT_SECRET=__SECRETO__
APP_JWT_EXPIRACION_MINUTOS=60


# ===== 6. SEGURIDAD DE ACCESO (RF-08, RNF-05) ================================
APP_SEGURIDAD_MAX_INTENTOS_FALLIDOS=5
APP_SEGURIDAD_MINUTOS_BLOQUEO=15


# ===== 7. CUENTA ADMINISTRADORA INICIAL (RF-06b) =============================
# Se crea sola si la tabla usuario esta vacia y obliga a completar identidad y
# contrasena en el primer ingreso. DESACTIVAR tras el primer despliegue.
APP_CUENTA_INICIAL_HABILITADA=true
APP_CUENTA_INICIAL_USERNAME=admin
APP_CUENTA_INICIAL_PASSWORD=__SECRETO__
APP_CUENTA_INICIAL_CORREO=admin@inictel-uni.edu.pe
APP_CUENTA_INICIAL_DNI=00000000


# ===== 8. CORS (RNF-10) ======================================================
# Origenes exactos del frontend, separados por coma. Sin comodines.
APP_CORS_ORIGENES_PERMITIDOS=http://localhost:4200


# ===== 9. ARCHIVOS: fotografias de los bienes (RF-51) ========================
# Carpeta donde se guardan las imagenes. La URL publica (/api/archivos) es
# parte del contrato de la API y no se configura aqui.
APP_ARCHIVOS_DIRECTORIO=./uploads


# ===== 10. DOCUMENTACION OPENAPI / SWAGGER (RNF-08) ==========================
# Se apaga en produccion para no exponer la superficie de la API.
SPRINGDOC_API_DOCS_ENABLED=true
