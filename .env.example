SERVER_PORT=8080
SERVER_TOMCAT_THREADS_MAX=400


# ===== 3. BASE DE DATOS (PostgreSQL 16+) =====================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/inventario
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=__SECRETO__

# Pool de conexiones (RNF-15). 300 usuarios concurrentes no necesitan 300
# conexiones: las peticiones son cortas y casi todas lecturas paginadas.
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=50
SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE=10


# ===== 4. JPA / HIBERNATE ====================================================
# El esquema lo administra Flyway (RNF-43); Hibernate solo valida.
# Aqui solo se elige si las consultas se imprimen en el log.
SPRING_JPA_SHOW_SQL=false

# RNF-11: hilos virtuales de Java 21.
SPRING_THREADS_VIRTUAL_ENABLED=true


# ===== 5. JWT (RF-02, RNF-02) ================================================
# Clave HMAC-SHA512. Minimo 64 caracteres.
# Generar:  openssl rand -base64 64
APP_JWT_SECRET=__SECRETO__
APP_JWT_EXPIRACION_MINUTOS=60


# ===== 6. SEGURIDAD DE ACCESO (RF-08, RNF-05) ================================
APP_SEGURIDAD_MAX_INTENTOS_FALLIDOS=5
APP_SEGURIDAD_MINUTOS_BLOQUEO=15


# ===== 7. CUENTA ADMINISTRADORA INICIAL (RF-06b) =============================
# Se crea sola si la tabla usuario esta vacia y obliga a completar identidad y
# contrasena en el primer ingreso. DESACTIVAR tras el primer despliegue.
APP_CUENTA_INICIAL_HABILITADA=true
APP_CUENTA_INICIAL_USERNAME=admin
APP_CUENTA_INICIAL_PASSWORD=__SECRETO__
APP_CUENTA_INICIAL_CORREO=admin@inictel-uni.edu.pe
APP_CUENTA_INICIAL_DNI=00000000


# ===== 8. CORS (RNF-10) ======================================================
APP_CORS_ORIGENES_PERMITIDOS=http://localhost:4200


# ===== 9. ARCHIVOS: fotografias y archivos ========================
APP_ARCHIVOS_DIRECTORIO=./uploads


# ===== 10. DOCUMENTACION OPENAPI / SWAGGER (RNF-08) ==========================
# Se apaga en produccion para no exponer la superficie de la API.
SPRINGDOC_API_DOCS_ENABLED=true

# Puertos publicados en el servidor (nginx escucha dentro del contenedor en los mismos 80 y 443).
PUERTO_HTTP=80
PUERTO_HTTPS=443
